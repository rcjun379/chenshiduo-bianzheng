{
  "skill_name": "chenshiduo-diagnosis",
  "version": "1.0",
  "created": "2026-08-11",
  "format": "darwin-skill-v1",
  "test_prompts": [
    {
      "id": "TP-001",
      "category": "should_trigger",
      "difficulty": "easy",
      "prompt": "我最近失眠一个多月了，晚上躺下两三个小时睡不着，心烦得很，腰酸，怕冷。",
      "expected": {
        "should_trigger": true,
        "expected_output_contains": [
          "四诊摘要",
          "八纲辨证",
          "心肾不交",
          "交通心肾",
          "处方",
          "上下两济汤",
          "肉桂",
          "黄连",
          "重要声明"
        ],
        "expected_behavior": "完整执行四诊采集（必要时追问）、八纲辨证、定位到心肾、立交通心肾法、出方、加重要声明"
      }
    },
    {
      "id": "TP-002",
      "category": "should_trigger",
      "difficulty": "easy",
      "prompt": "我妈 60 岁，最近一个月吃不下饭，吃完就胀，大便稀，一天两三次，人没力气。",
      "expected": {
        "should_trigger": true,
        "expected_output_contains": [
          "脾胃",
          "气虚",
          "补中益气",
          "黄芪",
          "党参或人参",
          "重要声明"
        ],
        "expected_behavior": "辨证为脾胃气虚，立补中益气法，出补中益气汤变方，提示老人特殊注意"
      }
    },
    {
      "id": "TP-003",
      "category": "should_trigger",
      "difficulty": "medium",
      "prompt": "我胁肋胀痛已经两周了，跟老公吵完架就更厉害，月经也不正常，量少，色暗。",
      "expected": {
        "should_trigger": true,
        "expected_output_contains": [
          "肝郁",
          "气滞",
          "逍遥散",
          "柴胡",
          "白芍",
          "重要声明"
        ],
        "expected_behavior": "辨证为肝郁气滞，立疏肝解郁法，出逍遥散加味"
      }
    },
    {
      "id": "TP-004",
      "category": "should_trigger",
      "difficulty": "medium",
      "prompt": "我后背上长了一个大疖子，红肿热痛，已经三天了，越来越重。",
      "expected": {
        "should_trigger": true,
        "expected_output_contains": [
          "热毒",
          "疔疮",
          "金银花",
          "清热解毒",
          "重要声明"
        ],
        "expected_behavior": "辨证为热毒壅盛（疔疮），出五味消毒饮或仙方活命饮，提示陈氏重剂金银花"
      }
    },
    {
      "id": "TP-005",
      "category": "should_trigger",
      "difficulty": "hard",
      "prompt": "我父亲 75 岁，最近半年怕冷得很，腰膝冷痛，夜尿多，每晚起夜四五次，大便稀，舌淡胖。",
      "expected": {
        "should_trigger": true,
        "expected_output_contains": [
          "肾阳虚",
          "畏寒",
          "腰膝冷痛",
          "金匮肾气丸",
          "附子",
          "重要声明"
        ],
        "expected_behavior": "辨证为肾阳虚衰，出金匮肾气丸或右归丸，提示老年 + 附子用量谨慎 + 复诊建议"
      }
    },
    {
      "id": "TP-006",
      "category": "should_trigger_with_followup",
      "difficulty": "medium",
      "prompt": "我最近不舒服。",
      "expected": {
        "should_trigger": true,
        "expected_output_contains": [
          "请详细描述",
          "主诉",
          "哪里不舒服",
          "持续多久"
        ],
        "expected_behavior": "信息不足，主动追问主诉（不超过 3 个问题）"
      }
    },
    {
      "id": "TP-007",
      "category": "should_not_trigger",
      "difficulty": "easy",
